# Application
PROJECT_NAME=TaskFlow API
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL in dev/prod)
DATABASE_URL=postgresql+psycopg://taskflow:taskflow_secret@localhost:5432/taskflow_db

# JWT & Security (Generate a strong secret with: openssl rand -hex 32)
JWT_SECRET_KEY=change-this-in-production-to-a-64-char-random-hex-secret-key-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (Login)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
